{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "reviewer",
    "independence_note",
    "verdict",
    "source_inspected",
    "base_commit",
    "result_commit",
    "inspected_files",
    "requirements",
    "checks_rerun",
    "findings",
    "unverified_claims",
    "recommended_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "independence_note": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "pass_with_caveats",
        "fail",
        "blocked"
      ]
    },
    "source_inspected": {
      "type": "boolean"
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "inspected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks_rerun": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "exit_code",
          "evidence_path",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "unknown"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "description",
          "evidence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "critical",
              "major",
              "minor",
              "informational"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
