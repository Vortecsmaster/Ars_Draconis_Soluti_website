{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "agent",
    "status",
    "started_at_utc",
    "finished_at_utc",
    "requirements",
    "base_commit",
    "result_commit",
    "initial_git_status",
    "changed_files",
    "prechecks",
    "postchecks",
    "evidence_files",
    "known_issues",
    "unverified_claims",
    "summary",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "pattern": "^TASK-[0-9]{3}$",
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "implemented",
        "blocked",
        "failed"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "initial_git_status": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prechecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "exit_code",
          "evidence_path",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "unknown"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "postchecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "exit_code",
          "evidence_path",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "unknown"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
